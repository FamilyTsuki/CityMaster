{
  "name": "citymaster",
  "version": "2.19.0",
  "description": "Geographic serious game using OpenStreetMap and Turf.js",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --import ./tests/setup.js --test tests/*.test.js",
    "lint": "eslint .",
    "check": "npm run lint && npm test",
    "make-admin": "node scripts/make-admin.js",
    "version:bump": "node scripts/bump-version.js"
  },
  "dependencies": {
    "@turf/turf": "^6.5.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0"
  },
  "engines": {
    "node": ">=20.11"
  }
}
