# Copier ce fichier en .env puis compléter les valeurs.

# Obligatoire : secret de signature des sessions (JWT) et des jetons de partie.
# Générer par exemple avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Port HTTP (3000 par défaut).
PORT=3000

# PostgreSQL. Si la base est injoignable au démarrage, le serveur passe en
# mode local (comptes dans config/users.json, scores en mémoire, pas de salons).
PGUSER=
PGPASSWORD=
PGHOST=localhost
PGPORT=5432
PGDATABASE=citymaster
# Forcer le mode local sans tenter de connexion :
# DB_DISABLED=true

# Connexion Google (facultatif) : identifiant client OAuth.
GOOGLE_CLIENT_ID=

# Pseudos administrateurs supplémentaires, séparés par des virgules (facultatif).
# Préférer `npm run make-admin -- <pseudo>` pour un compte existant.
# ADMIN_USERS=

# Derrière un reverse proxy (nginx, Traefik...) : nombre de proxys devant le
# serveur, pour que la limitation de débit voie la vraie adresse des joueurs.
# TRUST_PROXY=1

# Réservé aux tests : dossiers de données alternatifs.
# CITYMASTER_DATA_DIR=
# CITYMASTER_STATE_DIR=
